{
  "name": "capital-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "prisma generate && next build",
    "start": "next start -p 3004",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "check:rls": "tsx scripts/check-rls.mts",
    "check:gen": "tsx scripts/check-gen.mts",
    "check:gen:full": "tsx scripts/check-gen.mts --full"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@fal-ai/client": "^1.10.1",
    "@neondatabase/serverless": "^0.10.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.65.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.11",
    "openai": "^4.97.0",
    "pdf-parse": "^2.4.5",
    "posthog-js": "^1.399.2",
    "prisma": "^7.8.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "uuid": "^11.1.1",
    "@hono/node-server": "^1.19.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@next/eslint-plugin-next": "^16.2.10",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
